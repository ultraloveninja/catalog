{
  "name": "@catalog/standalone",
  "version": "4.0.1-canary.2",
  "engines": {
    "node": ">=18.0.0"
  },
  "description": "Standalone version of Catalog",
  "homepage": "https://www.catalog.style/",
  "bugs": "https://github.com/interactivethings/catalog/issues",
  "main": "catalog.min.js",
  "unpkg": "catalog.min.js",
  "exports": {
    ".": "./catalog.min.js",
    "./development": "./catalog.development.js",
    "./package.json": "./package.json"
  },
  "files": [
    "catalog.development.js",
    "catalog.min.js"
  ],
  "scripts": {
    "watch": "BROWSERSLIST_IGNORE_OLD_DATA=1 rollup -c rollup.config.js --bundleConfigAsCjs --watch",
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=1 rollup -c rollup.config.js --bundleConfigAsCjs"
  },
  "devDependencies": {
    "@catalog/core": "^4.0.1-canary.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/interactivethings/catalog.git"
  },
  "license": "BSD-3-Clause",
  "publishConfig": {
    "access": "public"
  }
}
