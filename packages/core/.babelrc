{
  "presets": [
    [
      "@babel/preset-env",
      {
        "loose": true,
        "modules": false,
        "bugfixes": true
      }
    ],
    "@babel/preset-react"
  ],
  "plugins": [["@emotion/babel-plugin", { "autoLabel": "always" }]],
  "env": {
    "test": {
      "presets": [
        [
          "@babel/preset-env",
          { "loose": true, "targets": { "node": "current" } }
        ],
        "@babel/preset-react",
        "@babel/preset-typescript"
      ],
      "plugins": [["@emotion/babel-plugin", { "autoLabel": "always" }]]
    }
  }
}
