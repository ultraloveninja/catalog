{
  "name": "@catalog/core",
  "version": "4.0.1-canary.2",
  "description": "Create living style guides using Markdown or React",
  "keywords": [
    "styleguide",
    "style guide",
    "docs",
    "documentation",
    "react",
    "markdown"
  ],
  "homepage": "https://www.catalog.style/",
  "bugs": "https://github.com/interactivethings/catalog/issues",
  "main": "dist/catalog.cjs.js",
  "module": "dist/catalog.es.js",
  "exports": {
    ".": {
      "types": "./types/catalog/index.d.ts",
      "import": "./dist/catalog.es.js",
      "require": "./dist/catalog.cjs.js",
      "default": "./dist/catalog.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=2.14.12"
  },
  "files": [
    "dist",
    "types"
  ],
  "types": "types/catalog",
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/react": "^11.13.5",
    "d3-color": "^1.1.0",
    "github-slugger": "^1.1.3",
    "sanitize-html": "^2.13.1",
    "js-yaml": "^3.9.1",
    "marked": "^11.2.0",
    "prismjs": "^1.14.0",
    "prop-types": "^15.7.2",
    "raf": "^3.3.2",
    "ramda": "^0.25.0",
    "react-router-dom": "^7.0.0",
    "srcset": "^2.0.0",
    "url": "^0.11.0"
  },
  "peerDependencies": {
    "@babel/standalone": "^7.1.0",
    "react": ">= 18.0.0",
    "react-dom": ">= 18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/interactivethings/catalog.git"
  },
  "license": "BSD-3-Clause",
  "jest": {
    "roots": [
      "<rootDir>/src"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
