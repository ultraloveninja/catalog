{
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "bootstrap": "yarn install",
    "dev": "run-p -l dev:*",
    "dev:lib": "rollup -c rollup.config.js --bundleConfigAsCjs --watch",
    "dev:doc": "yarn workspace @catalog/docs run dev",
    "build": "yarn build:lib && yarn build:standalone && yarn build:doc",
    "build:lib": "BROWSERSLIST_IGNORE_OLD_DATA=1 rollup -c rollup.config.js --bundleConfigAsCjs",
    "build:standalone": "yarn workspace @catalog/standalone run build",
    "build:doc": "yarn workspace @catalog/docs run build",
    "lint": "eslint packages docs",
    "test": "yarn test:types && yarn test:jest",
    "test:types": "tsc --build",
    "test:jest": "jest",
    "version:canary": "yarn test && yarn version:lerna-canary",
    "version:lerna-canary": "lerna version prerelease --preid=canary",
    "publish:canary": "scripts/publish-canary.sh"
  },
  "devDependencies": {
    "@babel/core": "^7.1.2",
    "@babel/eslint-parser": "^7.28.4",
    "@babel/plugin-syntax-jsx": "^7.0.0",
    "@babel/plugin-syntax-object-rest-spread": "^7.0.0",
    "@babel/preset-env": "^7.1.0",
    "@babel/preset-react": "^7.0.0",
    "@babel/preset-typescript": "^7.1.0",
    "@emotion/babel-plugin": "^11.13.5",
    "@eslint/js": "^9.17.0",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/express": "^4.16.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/source-map": "^0.5.7",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^30.2.0",
    "depcheck": "^0.6.11",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.14.0",
    "jest": "^30.2.0",
    "lerna": "^8.2.4",
    "npm-run-all": "^4.1.5",
    "release": "^6.0.0",
    "rollup": "^4.52.4",
    "tslib": "^2.8.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "util": "^0.12.5"
  },
  "jest": {
    "roots": [
      "<rootDir>/packages/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/packages/core/types/",
      "<rootDir>/packages/.*/lib/"
    ]
  },
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "browserslist": {
    "production": [
      "defaults and fully supports es6-module",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "resolutions": {
    "prop-types": "^15.7.2",
    "react-is": "^16.12.0"
  },
  "dependencies": {
    "prop-types": "^15.7.2"
  }
}
